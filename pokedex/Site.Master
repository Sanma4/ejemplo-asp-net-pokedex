<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="pokedex.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    <form id="form2" runat="server">
        <nav class="navbar navbar-expand-lg bg-body-tertiary" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="Default.aspx">POKEDEX</a>
                <div class="collapse navbar-collapse" id="navbarTogglerDemo02">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="Default.aspx">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="ListaPokemons.aspx">Lista de Pokemons</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Favoritos.aspx">Favoritos</a>
                        </li>

                    </ul>
                </div>
                <div class="d-flex">

                    <%if (!negocio.Seguridad.SessionIniciada(Session["trainee"]))
                        { %>
                    <a href="Login.aspx" class="btn btn-outline-success me-2">Login</a>
                    <a href="Register.aspx" class="btn btn-outline-primary me-2">Registrarse</a>
                    <%}
                        else
                        { %>

                    <asp:Button ID="btnSalir" runat="server" CssClass="btn btn-outline-danger me-2" Text="Salir" OnClick="btnSalir_Click" />

                    <%} %>

                    <a href="MiPerfil.aspx">
                        <asp:Image ID="imgPerfil" Style="height: 40px; width: 40px; border-radius: 50%;"
                            runat="server" />
                    </a>
                </div>
            </div>


        </nav>

        <div class="container">
            <hr />
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>
</body>
    <hr />
<footer>
    <h5 style="text-align:center; font-size:20px;">DERECHOS RESERVADOS</h5>
    <h6 style="text-align:center; font-size:10px;">Desing by Sanma</h6>
</footer>
</html>
